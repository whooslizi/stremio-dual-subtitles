{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "scrapers/**",
        "lib/**",
        "addon.js",
        "server.js",
        "encoding.js",
        "languages.js",
        "landingTemplate.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
